// HRMP — مخطط قاعدة البيانات (SQLite + Prisma)
// ملكية: المساعد الثاني (تغييرات البنية عبر migrations فقط — راجع docs/DATABASE_GUIDE.md)
// قواعد نافذة: companyId في كل جدول تشغيلي | المال Int بالسنتيم | UTC في التخزين
// ملاحظة SQLite: لا enums — القيم النصية تُتحقق في طبقة التطبيق (src/lib/rbac.ts)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// البنية المؤسسية (SPEC §3)
// ─────────────────────────────────────────────────────────────

/// كيان مالك المنصة (white-label) — ليس حسابًا شخصيًا (SPEC §3.2)
model PlatformOwner {
  id              String   @id @default(cuid())
  legalName       String
  displayName     String
  contactEmail    String?
  contactPhone    String?
  logoUrl         String?
  defaultLocale   String   @default("ar")
  defaultCurrency String   @default("MAD")
  // ── المرحلة 8 (SPEC §3.2: التخصيص white-label + نقل الملكية) — ملكية التغيير: المساعد الأول
  // ⚠️ بانتظار migration موقّعة (مع المعلقة للمرحلة 7) — راجع docs/WORKLOG.md
  websiteUrl      String? // موقع المالك (تخصيص الهوية)
  termsUrl        String? // شروط الاستخدام (إعداد تخصيص — SPEC §3.2)
  footerText      String? // تذييل التقارير والوثائق (إعداد تخصيص — SPEC §3.2)
  modulesJson     String? // تفعيل/تعطيل الوحدات والمسارات بحسب المالك (JSON) — null = الكل مفعّل
  transferFreeze  Boolean  @default(false) // تجميد مؤقت للتغييرات الإدارية أثناء نقل الملكية (SPEC §3.2 خطوة 1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companies Company[]
}

/// الشركة (المستأجر) — عزل البيانات عبر companyId في كل جدول تشغيلي
model Company {
  id              String   @id @default(cuid())
  platformOwnerId String?
  legalName       String
  tradeName       String?
  /// أسماء محلية اختيارية JSON {ar,fr,en,es} — العرض بحسب لغة الواجهة وإلا الاسم الأساسي
  names           String?
  taxId           String? // ICE
  cnssNumber      String?
  locale          String   @default("ar")
  timezone        String   @default("Africa/Casablanca")
  currency        String   @default("MAD")
  status          String   @default("active") // active | suspended
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  platformOwner        PlatformOwner?       @relation(fields: [platformOwnerId], references: [id])
  memberships          UserMembership[]
  grants               AccountantGrant[]
  settings             CompanySettings?
  payRules             PayRule[]
  verificationPolicies VerificationPolicy[]
  auditLogs            AuditLog[]
  branches             Branch[]
  projects             Project[]
  sites                Site[]
  workerGroups         WorkerGroup[]
  shiftTemplates       ShiftTemplate[]
  shifts               Shift[]
  shiftRecurrences     ShiftRecurrence[]
  attendanceEvents     AttendanceEvent[]
  notifications        Notification[]
  holidays             Holiday[]
  employeeProfiles     EmployeeProfile[]
  payPeriods           PayPeriod[]
  payslips             Payslip[]
  ledgerEntries        LedgerEntry[]
  payRegimes           PayRegime[]
  regimeAssignments    RegimeAssignment[]
  declarationSpecs     DeclarationSpec[]
  declarations         Declaration[]
  generatedDocuments   GeneratedDocument[]
  vacancies            ProjectVacancy[]

  @@index([status])
}

/// هوية المستخدم الواحدة — العلاقة بالشركات عبر العضويات فقط (SPEC §3.1)
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  phone                 String?
  fullName              String
  /// أسماء محلية اختيارية JSON {ar,fr,en,es} للعرض بحسب لغة الواجهة — وإلا الاسم الأساسي
  /// (علاج بلاغ المالك 2026-10-23 «خلل ترجمة اسم العامل/المستخدم»)
  names                 String?
  passwordHash          String
  isActive              Boolean   @default(true)
  twoFactorEnabled      Boolean   @default(false)
  locale                String    @default("ar")
  lastLoginAt           DateTime?
  sessionsInvalidatedAt DateTime? // إبطال كل جلسات صدرت قبله (خروج فعلي/تدوير أمان)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships         UserMembership[]
  grants              AccountantGrant[]
  auditActions        AuditLog[]
  workerShifts        Shift[]                @relation("ShiftWorker")
  workerRecurrences   ShiftRecurrence[]      @relation("RecurrenceWorker")
  attendanceEvents    AttendanceEvent[]      @relation("AttendanceWorker")
  notifications       Notification[]         @relation("NotificationRecipient")
  pushDevices         Device[]               @relation("DeviceOwner")
  employeeProfiles    EmployeeProfile[]      @relation("EmployeeProfileUser")
  payslips            Payslip[]              @relation("PayslipWorker")
  ledGroups           WorkerGroup[]          @relation("GroupLeader")
  groupMemberships    WorkerGroupMember[]    @relation("GroupMember")
  locationPings       MemberLocationPing[]   @relation("LocationReporter")
  sentVoices          VoiceMessage[]         @relation("VoiceSender")
  receivedVoices      VoiceMessage[]         @relation("VoiceRecipient")
  sentDirect          DirectMessage[]        @relation("DirectSender")
  receivedDirect      DirectMessage[]        @relation("DirectRecipient")
  startedCalls        CallSession[]          @relation("CallCaller")
  receivedCalls       CallSession[]          @relation("CallCallee")
  grantedDelegations  PermissionDelegation[] @relation("DelegationGrantor")
  receivedDelegations PermissionDelegation[] @relation("DelegationGrantee")

  @@index([isActive])
}

/// عضوية المستخدم في شركة بدور واحد (SPEC §3.1) — الجلسة تعمل بشركة نشطة واحدة
model UserMembership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      String // super_admin | accountant | admin | co_admin | employee
  scopeJson String? // نطاق co_admin: JSON نصي لمجموعات/مواقع مسندة
  isDefault Boolean   @default(false)
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId, role])
}

/// منح المحاسب الخارجي — صريحة، مؤقتة، قابلة للسحب (SPEC §3.3)
model AccountantGrant {
  id        String    @id @default(cuid())
  companyId String
  userId    String
  mode      String    @default("external") // internal | external
  grantedBy String
  startsAt  DateTime
  endsAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
}

// ─────────────────────────────────────────────────────────────
// البنية التنظيمية والمواقع (SPEC §5 و§8 — المرحلة 2)
// الأرشفة بدل الحذف (status=archived) حفاظًا على سلامة المراجع (SPEC §11.7)
// ─────────────────────────────────────────────────────────────

/// فرع الشركة (SPEC §5: branches) — يضم مشاريع ومواقع
model Branch {
  id        String @id @default(cuid())
  companyId String
  name      String

  /// أسماء محلية اختيارية JSON {ar,fr,en,es} — العرض بحسب لغة الواجهة وإلا الاسم الأساسي
  names     String?
  code      String?
  city      String?
  address   String?
  /// عناوين محلية اختيارية JSON {ar,fr,en,es} — العرض بحسب لغة الواجهة وإلا العنوان الأساسي
  /// (علاج بلاغ المالك 2026-10-23 «خلل ترجمة العناوين الجغرافية»)
  addresses String?
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  projects Project[]
  sites    Site[]

  @@index([companyId, status])
}

/// مشروع/عقد داخل الشركة (SPEC §5: projects) — يُسنَد له مواقع
model Project {
  id        String  @id @default(cuid())
  companyId String
  branchId  String?
  name      String

  /// أسماء محلية اختيارية JSON {ar,fr,en,es} — العرض بحسب لغة الواجهة وإلا الاسم الأساسي
  names     String?
  code      String?
  status    String    @default("active") // active | archived
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company          @relation(fields: [companyId], references: [id])
  branch    Branch?          @relation(fields: [branchId], references: [id])
  sites     Site[]
  vacancies ProjectVacancy[]

  @@index([companyId, status])
  @@index([companyId, branchId])
}

/// موقع العمل: نقطة مركز + نصف قطر للتحقق الجغرافي (SPEC §4.2 و§5: sites)
/// latitude/longitude عشرية Float — نطاقها يُتحقق في طبقة التطبيق (zod)؛ SQLite بلا PostGIS
model Site {
  id        String  @id @default(cuid())
  companyId String
  branchId  String?
  projectId String?
  name      String

  /// أسماء محلية اختيارية JSON {ar,fr,en,es} — العرض بحسب لغة الواجهة وإلا الاسم الأساسي
  names     String?
  address   String?
  /// عناوين محلية اختيارية JSON {ar,fr,en,es} — العرض بحسب لغة الواجهة وإلا العنوان الأساسي
  /// (علاج بلاغ المالك 2026-10-23 «خلل ترجمة العناوين الجغرافية»)
  addresses String?
  latitude  Float // [-90, 90]
  longitude Float // [-180, 180]
  radiusM   Int      @default(50) // نصف قطر التحقق بالمتر (SPEC §4.2: افتراضي 50 م)
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company              Company              @relation(fields: [companyId], references: [id])
  branch               Branch?              @relation(fields: [branchId], references: [id])
  project              Project?             @relation(fields: [projectId], references: [id])
  verificationPolicies VerificationPolicy[]
  shifts               Shift[]
  shiftRecurrences     ShiftRecurrence[]
  attendanceEvents     AttendanceEvent[]
  groups               WorkerGroup[]        @relation("GroupSite")

  @@index([companyId, status])
  @@index([companyId, branchId])
  @@index([companyId, projectId])
}

/// مجموعة عمال = فريق ميداني (SPEC §5: worker_groups) — تُستخدم في الجدولة والتغطية (المرحلة 3+)
/// المرحلة 9 (v0.10.0): قائد الفريق + النوع (عادي/احتياطي) + منطقة جغرافية للفريق
/// (حدود المساحة الجغرافية المحددة للفريق — طلب المالك 2026-10-18) + أعضاء صريحون
model WorkerGroup {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  description  String?
  status       String   @default("active") // active | archived
  kind         String   @default("regular") // regular | reserve — فرق الإحتياط (يعيّنها الأدمن)
  leaderUserId String? // مسؤول الفريق — يُخطر آنيًا عند دخول/مغادرة الأعضاء منطقة الفريق
  siteId       String? // موقع العمل المرجعي — المنطقة الجغرافية تُشتق منه إن لم تُحدد مباشرة
  zoneLat      Float? // مركز منطقة الفريق — إن خلا الحقلان استُخدم موقع الموقع المرجعي
  zoneLng      Float?
  zoneRadiusM  Int?     @default(150) // نصف قطر منطقة الفريق (م) — أوسع من نطاق التحقق (50م) لأنه متابعة لا تسجيل حضور
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  leader  User?               @relation("GroupLeader", fields: [leaderUserId], references: [id])
  site    Site?               @relation("GroupSite", fields: [siteId], references: [id])
  members WorkerGroupMember[]

  @@index([companyId, status])
  @@index([companyId, kind])
  @@index([leaderUserId])
}

/// عضوية عامل/حرفي/تقني في فريق (المرحلة 9) — دورة حياة بالإزالة المؤرخة (نمط UserMembership)
/// لا قيد فريد مركّب: الإضافة تتحقق في الخدمة من عدم وجود عضوية سارية (وإلا تعارضت مع الإزالة/الإعادة)
model WorkerGroupMember {
  id          String    @id @default(cuid())
  companyId   String
  groupId     String
  userId      String
  jobTitleKey String? // مسمى وظيفي داخل الفريق من الكتالوج (اختياري — المهنة الأساسية في الملف)
  status      String    @default("active") // active | removed
  addedAt     DateTime  @default(now())
  addedBy     String? // من أضافه (تدقيق)
  removedAt   DateTime?

  group WorkerGroup @relation(fields: [groupId], references: [id])
  user  User        @relation("GroupMember", fields: [userId], references: [id])

  @@index([groupId, status])
  @@index([companyId, userId, status])
}

/// نبضة موقع آنية لعضو فريق (المرحلة 9) — المراقبة الحية للوجود داخل/خارج منطقة الفريق
/// المصدر: مراقب المتصفح أثناء فتح اللوحة (watcher) أو إرسال يدوي — لا تتبع خلفي (خصوصية)
model MemberLocationPing {
  id         String   @id @default(cuid())
  companyId  String
  groupId    String? // الفريق الذي أُرسلت النبضة في سياقه (فريق المتصل للمراقبة)
  userId     String
  lat        Float
  lng        Float
  accuracyM  Float?
  source     String   @default("watcher") // watcher | manual
  reportedAt DateTime @default(now())

  user User @relation("LocationReporter", fields: [userId], references: [id])

  @@index([companyId, userId, reportedAt])
  @@index([groupId, reportedAt])
}

/// رسالة صوتية مباشرة (المرحلة 9) — عزل الفرق: تخزَّن بنطاق فريق المُرسل،
/// ولا تُقرأ إلا لطرفيها ومن يملك صلاحية الإشراف (سوبر/أدمن/كوأدمن)
model VoiceMessage {
  id          String    @id @default(cuid())
  companyId   String
  groupId     String? // فريق السياق (بلا فريق = رسالة إشرافية مباشرة من الإدارة لمستخدم بلا فريق) — رسائل الأعضاء محصورة في فريق مشترك حصرًا
  senderId    String
  recipientId String
  durationSec Int       @default(0)
  mime        String    @default("audio/webm")
  sizeBytes   Int       @default(0)
  audio       Bytes // المحتوى الثنائي (SQLite BLOB) — مقاطع قصيرة ≤ 120ث
  listenedAt  DateTime? // وقت استماع المستقبِل (أول تشغيل)
  createdAt   DateTime  @default(now())
  purgedAt    DateTime? // لحظة مسح المحتوى الصوتي (استهلاك أو TTL) — بعدها البث 410
  purgedBy    String? // من مسحها: معرّف المستقبِل/المشرف أو "ttl"

  sender    User @relation("VoiceSender", fields: [senderId], references: [id])
  recipient User @relation("VoiceRecipient", fields: [recipientId], references: [id])

  @@index([companyId, groupId, createdAt])
  @@index([recipientId, listenedAt])
  @@index([purgedAt])
}

/// مراسلة مباشرة بين المستخدمين: مرئية (صورة/فيديو) وموقعية (بلاغ المالك
/// 2026-10-24) — نفس نموذج عزل الصوتيات (فريق مشترك أو إشراف)؛ الحمولة BLOB
/// للموقع null مع إحداثيات lat/lng. النسخ الحية عبر SSE (api/realtime).
model DirectMessage {
  id          String    @id @default(cuid())
  companyId   String
  groupId     String? // فريق السياق — نفس منطق الصوتيات
  senderId    String
  recipientId String
  kind        String // "photo" | "video" | "location"
  mime        String    @default("") // image/jpeg | video/webm | video/mp4 — "" للموقع
  sizeBytes   Int       @default(0)
  durationSec Int       @default(0) // للفيديو فقط
  lat         Float?
  lng         Float?
  accuracyM   Float?
  media       Bytes? // الحمولة للموقع null
  viewedAt    DateTime? // وقت مشاهدة المستقبِل (مقابل listenedAt للصوت)
  createdAt   DateTime  @default(now())

  sender    User @relation("DirectSender", fields: [senderId], references: [id])
  recipient User @relation("DirectRecipient", fields: [recipientId], references: [id])

  @@index([companyId, groupId, createdAt])
  @@index([recipientId, viewedAt])
}

/// جلسة اتصال مباشر (بلاغ المالك 2026-10-24): صوت/صورة آني بين مستخدمَين عبر
/// WebRTC — الوسائط تتدفق نظير-إلى-نظير مشفّرة (DTLS-SRTP) ولا تمرّ بالخادم
/// ولا تُخزّن في المنصة إطلاقًا؛ هذا السجل بيانات وصفية للتدقيق فقط
/// (من اتصل بمن، متى، المدة، الحالة) بلا أي محتوى وسائط.
model CallSession {
  id        String    @id @default(cuid())
  companyId String
  callerId  String
  calleeId  String
  media     String // audio | video
  status    String    @default("ringing") // ringing | active | ended | declined | missed
  startedAt DateTime? // لحظة اتصال الوسائط فعليًا
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  caller User @relation("CallCaller", fields: [callerId], references: [id])
  callee User @relation("CallCallee", fields: [calleeId], references: [id])

  @@index([companyId, createdAt])
  @@index([calleeId, status, createdAt])
}

/// إشارة تأشير WebRTC (بلاغ المالك 2026-10-24): ring/offer/answer/ice/end/decline
/// — إشارات تأسيس الاتصال وحدها تمرّ بالخادم (SDP ومرشحو ICE)
/// وهي قصيرة العمر: تُحذف بعد دقائق من إنشائها؛ الوسائط نفسها لا تلمس الخادم أبدًا.
model CallSignal {
  id          String   @id @default(cuid())
  companyId   String
  callId      String
  fromUserId  String
  toUserId    String
  kind        String // ring | offer | answer | ice | end | decline | busy
  payloadJson String // JSON قصير (SDP أو مرشح ICE بلا حمولة) — مؤقت بطبيعته
  createdAt   DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([createdAt])
}

/// تفويض صلاحية (المرحلة 9) — السوبر أدمن وحده يفوّض؛ يمنح صلاحية فوق دور المنحوح له
/// حتى انتهاء الصلاحية أو سحبها — تحقق دائم في الخادم عند كل فعل حساس
model PermissionDelegation {
  id         String    @id @default(cuid())
  companyId  String
  grantorId  String // السوبر أدمن المفوِّض
  granteeId  String // المستخدم المنحوح له
  permission String // من PERMISSIONS (rbac.ts) — القابلة للتفويض موثقة في delegations.ts
  note       String?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime? // null = بلا انتهاء
  revokedAt  DateTime?

  grantor User @relation("DelegationGrantor", fields: [grantorId], references: [id])
  grantee User @relation("DelegationGrantee", fields: [granteeId], references: [id])

  @@index([companyId, granteeId])
  @@index([companyId, grantorId])
}

// ─────────────────────────────────────────────────────────────
// الجدولة (SPEC §4.1 و§8 — المرحلة 3)
// التخزين UTC (startsAt/endsAt) لمنع التعارض بالفترات؛ localDate = يوم البداية بتوقيت الشركة
// الأرشفة/الإلغاء بدل الحذف (SPEC §11.7) — سجلات الجدولة تُغذي الحضور والأجور لاحقاً
// ─────────────────────────────────────────────────────────────

/// قالب وردية بحسب القطاع (SPEC §4.1): حراسة (ليل متصل)، بناء (نهار محدد)، نظافة (توزيع متعدد)
/// startTimeMin/endTimeMin = دقائق من منتصف الليل بتوقيت الشركة؛ endTime ≤ start = وردية تعبر منتصف الليل
model ShiftTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  sector       String   @default("other") // security | construction | cleaning | gardening | crafts | other
  startTimeMin Int // 0..1439
  endTimeMin   Int // 0..1439
  breakMinutes Int      @default(0)
  notes        String?
  status       String   @default("active") // active | archived
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company           @relation(fields: [companyId], references: [id])
  shifts      Shift[]
  recurrences ShiftRecurrence[]

  @@index([companyId, status])
  @@index([companyId, sector])
}

/// وردية مجدولة (إسناد عامل لموقع بوقت محدد) — وحدة منع التعارض: عامل في موقعين بنفس الوقت ممنوع (SPEC §4.1)
model Shift {
  id              String   @id @default(cuid())
  companyId       String
  workerUserId    String
  siteId          String
  templateId      String?
  recurrenceId    String?
  localDate       String // "YYYY-MM-DD" بتوقيت الشركة (يوم بداية الوردية)
  startsAt        DateTime // UTC
  endsAt          DateTime // UTC — قد تعبر منتصف الليل (SPEC §11.4: وردية 22:00–06:00)
  breakMinutes    Int      @default(0)
  status          String   @default("scheduled") // scheduled | cancelled
  source          String   @default("manual") // manual | recurrence | rotation | replacement
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  worker           User              @relation("ShiftWorker", fields: [workerUserId], references: [id])
  site             Site              @relation(fields: [siteId], references: [id])
  template         ShiftTemplate?    @relation(fields: [templateId], references: [id])
  recurrence       ShiftRecurrence?  @relation(fields: [recurrenceId], references: [id])
  attendanceEvents AttendanceEvent[]

  @@index([companyId, workerUserId, startsAt])
  @@index([companyId, siteId, startsAt])
  @@index([companyId, status, startsAt])
  @@index([recurrenceId])
}

/// قاعدة ورديات متكررة (fixed: قالب ثابت بأيام أسبوع) أو متناوبة (rotating: دورة قوالب مرتبة) — SPEC §4.1
model ShiftRecurrence {
  id               String   @id @default(cuid())
  companyId        String
  workerUserId     String
  siteId           String
  mode             String   @default("fixed") // fixed | rotating
  templateId       String? // للنمط fixed
  rotationJson     String? // للنمط rotating: JSON مصفوفة معرفات قوالب بالترتيب
  rotationStepDays Int      @default(7) // أيام لكل خطوة في الدورة
  weekdaysJson     String? // للنمط fixed: JSON [0..6] (0=الأحد)
  startsOn         String // "YYYY-MM-DD"
  endsOn           String?
  status           String   @default("active") // active | archived
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id])
  worker   User           @relation("RecurrenceWorker", fields: [workerUserId], references: [id])
  site     Site           @relation(fields: [siteId], references: [id])
  template ShiftTemplate? @relation(fields: [templateId], references: [id])
  shifts   Shift[]

  @@index([companyId, status])
  @@index([companyId, workerUserId])
}

// ─────────────────────────────────────────────────────────────
// الحضور والتحقق الجغرافي (SPEC §4.2 و§8 — المرحلة 4)
// append-only: سجلات الحضور لا تُحذف أبدًا (SPEC §11.7) — الرفض يُسجَّل أيضًا كمحاولة
// التخزين UTC (occurredAt وقت العميل، recordedAt وقت الخادم الفاصل)؛ المسافة تُحسب في الخادم حصرًا
// ─────────────────────────────────────────────────────────────

/// حدث حضور/انصراف واحد (check_in | check_out) — القلب: تحقق خادمي بالنطاق الجغرافي + مكافحة التلاعب + سياسة التحقق
model AttendanceEvent {
  id               String    @id @default(cuid())
  companyId        String
  workerUserId     String
  siteId           String
  shiftId          String? // الوردية المرتبطة إن وُجدت مطابقة زمنية
  type             String // check_in | check_out
  occurredAt       DateTime // وقت العميل المُبلَّغ (UTC)
  recordedAt       DateTime  @default(now()) // وقت الخادم الفاصل (UTC) — المرجع
  latitude         Float // [-90, 90]
  longitude        Float // [-180, 180]
  accuracyM        Float? // دقة GPS المُبلَّغة بالمتر
  distanceM        Float? // المسافة من مركز الموقع (Haversine) — محسوبة في الخادم
  insideFence      Boolean // داخل نصف قطر الموقع؟
  policy           String    @default("none") // السياسة المطلوبة وقت التسجيل: none|qr|face|qr_and_face|qr_or_face
  verification     String    @default("none") // ما تحقق فعلاً لنفس الأنماط
  qrNonce          String?   @unique // nonce من رمز QR المستخدم — منع إعادة الاستخدام (SPEC §4.2)
  status           String    @default("verified") // verified | pending_review | rejected
  reason           String? // outside_fence|poor_accuracy|mock_location|impossible_jump|qr_missing|qr_invalid|face_missing|face_failed|review_rejected
  deviceJson       String? // بصمة الجهاز المُبلَّغة (platform/mockLocation/rooted/emulator) — بلا معرّفات حساسة
  spoofJson        String? // نتيجة فحوص مكافحة التلاعب في الخادم (JSON نصي)
  networkMode      String    @default("internet") // lan | internet — للعرض فقط؛ القواعد واحدة في الوضعين (SPEC §4.2)
  reviewNotes      String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  worker  User    @relation("AttendanceWorker", fields: [workerUserId], references: [id])
  site    Site    @relation(fields: [siteId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  @@index([companyId, workerUserId, occurredAt])
  @@index([companyId, siteId, occurredAt])
  @@index([companyId, status, occurredAt])
  @@index([type, occurredAt])
  // فحص السعة 2026-10-19: استعلام نطاق الحضور (companyId + occurredAt range)
  // كان يستعمل فهرس companyId+status+occurredAt فيرتب كل صفوف الشركة
  // (USE TEMP B-TREE FOR ORDER BY) ⇒ قياس A/B: 10.3 ⇒ 24.8 req/s بعد هذا الفهرس
  // (p50 905ms ⇒ 400ms) على 100k صف حضور.
  @@index([companyId, occurredAt])
}

// ─────────────────────────────────────────────────────────────
// الإعدادات والسياسات
// ─────────────────────────────────────────────────────────────

/// إعدادات الشركة (SPEC §11): قيم العمل بقيم افتراضية مغربية
model CompanySettings {
  id                          String   @id @default(cuid())
  companyId                   String   @unique
  workWeekHours               Int      @default(44)
  restDay                     Int      @default(5) // 0=الأحد … 5=الجمعة
  monthlyHoursDivisor         Int      @default(191)
  overtimeCapAnnual           Int? // اختياري (SPEC §11.4)
  showWagesToSupervisor       Boolean  @default(false)
  dualApprovalEnabled         Boolean  @default(false)
  showEmployerShareToEmployee Boolean  @default(false) // إظهار حصة المشغّل في قسيمة العامل (SPEC §4.4.1: الافتراضي الإخفاء)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

/// سياسة التحقق من الهوية عند الحضور (SPEC §4.2) — على مستوى الشركة (والموقع لاحقًا)
model VerificationPolicy {
  id               String   @id @default(cuid())
  companyId        String? // null = مستوى المنصة
  siteId           String? // مستوى الموقع (المرحلة 2+)
  policy           String   @default("none") // none | qr | face | qr_and_face | qr_or_face
  faceAcknowledged Boolean  @default(false) // إقرار المالك القانوني لتفعيل face
  updatedAt        DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  site    Site?    @relation(fields: [siteId], references: [id])

  @@unique([companyId, siteId])
}

// ─────────────────────────────────────────────────────────────
// قواعد الأجور (SPEC §11) — بيانات بتواريخ سريان، لا ثوابت كود
// ─────────────────────────────────────────────────────────────

/// سطر قاعدة أجر واحد:companyId=null يعني مستوى المنصة
model PayRule {
  id            String    @id @default(cuid())
  companyId     String?
  key           String // مثال: smig.hourly | cnss.employee.short | ir.brackets
  valueInt      Int? // بالسنتيم أو بنقاط الأساس x10000
  valueText     String? // للقيم غير الرقمية (JSON الشرائح، الأوقات)
  unit          String    @default("cents") // cents | basis_points | text | hours
  effectiveFrom DateTime
  source        String?
  verifiedBy    String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  @@unique([companyId, key, effectiveFrom])
  @@index([key, effectiveFrom])
}

// ─────────────────────────────────────────────────────────────
// سجل التدقيق (SPEC §3 و§6) — append-only
// ─────────────────────────────────────────────────────────────

/// كل فعل حساس: من، متى، ماذا، قبل/بعد، السبب
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String? // null = حدث على مستوى المنصة
  userId     String? // الفاعل (null = نظام)
  action     String // auth.login | company.switch | user.create | ...
  entity     String?
  entityId   String?
  beforeJson String? // JSON نصي
  afterJson  String? // JSON نصي
  reason     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─────────────────────────────────────────────────────────────
// التغطية السريعة والإشعارات (SPEC §4.1 و§8 — المرحلة 5)
// سحب بديل عند الغياب + إشعار فوري للبديل + تحديث برنامجه
// ─────────────────────────────────────────────────────────────

/// إشعار داخل التطبيق: type + payloadJson — النص يُبنى في الواجهة بلغة المستخدم (i18n)
/// الإرسال «الفوري» عبر: (1) استطلاع الواجهة كل 20ث (2) محوّل Web Push قابل للتبديل (SPEC §7)
model Notification {
  id          String    @id @default(cuid())
  companyId   String
  userId      String // المستقبِل
  type        String // shift_replacement_assigned | shift_replacement_note | ...
  payloadJson String? // {siteName, localDate, startLabel, endLabel, ...}
  readAt      DateTime? // null = غير مقروء
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation("NotificationRecipient", fields: [userId], references: [id])

  @@index([companyId, userId, createdAt])
  @@index([userId, readAt])
}

/// اشتراك دفع لمتصفح/جهاز (SPEC: كيان devices): Web Push (VAPID) — محوّل قابل للتبديل (SPEC §7)
model Device {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique // عنوان اشتراك Web Push (RFC 8030)
  p256dh    String // مفتاح تشفير الاشتراك
  auth      String // سر التفويض
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("DeviceOwner", fields: [userId], references: [id])

  @@index([userId, isActive])
}

// ─────────────────────────────────────────────────────────────
// الأجور (SPEC §4.3 و§11 — المرحلة 6أ+6ب)
// ⚠️ ملكية المخطط للمساعد الثاني (COORDINATION §3) — نُفِّذت هنا لسابقة المرحلتين 4/5
// وغياب بيئة المساعد الثاني — **يُرجى مراجعتها واعتمادها + migration موقّعة (4+5+6 معًا)**.
// القواعد النافذة: المال Int بالسنتيم | القواعد من pay_rules بتواريخ سريان | النسب أساس 10000
// الكشف المعتمد يُقفل ولا يُعدَّل إلا بقيد تصحيح جديد (SPEC §4.3) — snapshotJson نسخة ثابتة
// ─────────────────────────────────────────────────────────────

/// عطلة رسمية (SPEC §11.5 و§11.4): لكل شركة بتاريخ مؤكد — يدخلها admin كل سنة
/// (العطل الدينية متغيرة برؤية الهلال — لا تُخمَّن أبدًا)؛ يوم العطلة يُعامل كيوم راحة في الإضافي (SPEC §11.4)
model Holiday {
  id        String   @id @default(cuid())
  companyId String
  localDate String // "YYYY-MM-DD"
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, localDate])
  @@index([companyId, localDate])
}

/// ملف أجر العامل في الشركة (SPEC §4.3 أنظمة الاحتساب + §11.6 الأعباء العائلية)
/// payType: hourly (دقائق فعلية من الدخول للخروج) | daily (باليوم/الوردية) | monthly (شهري مع خصم الغياب)
model EmployeeProfile {
  id              String    @id @default(cuid())
  companyId       String
  userId          String
  payType         String    @default("hourly") // hourly | daily | monthly
  hourlyRateCents Int? // بالساعة (سنتيم)
  dailyRateCents  Int? // باليوم/الوردية (سنتيم)
  monthlyCents    Int? // أجر شهري أساسي (سنتيم)
  transportZone   String    @default("urban") // urban | outside — سقف تعويض النقل المعفى (SPEC §11.6)
  dependentsCount Int       @default(0) // الأعباء العائلية للـ IR — تُدخلها الإدارة بوثائق (SPEC §11.6)
  hireDate        DateTime? // لعلاوة الأقدمية لاحقًا (تحتاج مراجعة محاسب — SPEC §11.6)
  cin             String? // رقم البطاقة الوطنية — إلزامي للتصاريح الرسمية (SPEC §4.6: رفض الملف بدونه)
  cnssNumber      String? // رقم CNSS للعامل — إلزامي لتصريح Damancom (SPEC §4.6)
  jobTitleKey     String? // المسمى الوظيفي من الكتالوج المعتمد (المرحلة 9) — مهنة الشخص الأساسية
  jobTitleCustom  String? // مسمى حر خارج الكتالوج — يُعرض بجانب المسمى الرسمي إن وُجد
  status          String    @default("active") // active | archived
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation("EmployeeProfileUser", fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([companyId, status])
}

/// فترة أجور شهرية لكل شركة (SPEC §4.3): دورة الاعتماد مسودة → مراجعة → معتمد (admin)
/// بعد الاعتماد تُقفل الفترة وكشوفها — التصحيح بقيد جديد في فترة لاحقة فقط
model PayPeriod {
  id          String    @id @default(cuid())
  companyId   String
  year        Int
  month       Int // 1..12
  status      String    @default("draft") // draft | reviewing | approved
  generatedAt DateTime?
  submittedAt DateTime?
  submittedBy String? // userId
  approvedBy  String? // userId (admin — SPEC §4.3)
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  payslips Payslip[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
}

/// كشف أجر عامل لفترة واحدة (SPEC §5: payslips): رقم مرجعي فريد + كل المبالغ بالسنتيم
/// snapshotJson تُجمَّد عند الاعتماد (SPEC §4.4.1: المستند المعتمد لا يتغير)
model Payslip {
  id                   String   @id @default(cuid())
  companyId            String
  periodId             String
  workerUserId         String
  refNumber            String // PS-YYYYMM-NNNN — فريد داخل الشركة
  workedMinutes        Int      @default(0) // صافي مدفوع الأساس (بدون دقائق الإضافي)
  breakMinutes         Int      @default(0) // استراحات مخصومة من المجدول
  overtimeMinutes      Int      @default(0) // مجموع دقائق الإضافي بكل النسب
  workedDays           Int      @default(0) // أيام عمل فعلية (سقوف منح الوجبات اليومية)
  grossCents           Int      @default(0) // الأجر الإجمالي (brut)
  sbiCents             Int      @default(0) // الإجمالي الخاضع للـ IR (بعد المعفاة)
  cnssBaseCents        Int      @default(0) // الأساس الخاضع للـ CNSS/AMO
  cnssEmployeeCents    Int      @default(0) // حصة الأجير CNSS (قصير + طويل بسقف 6000)
  amoEmployeeCents     Int      @default(0) // حصة الأجير AMO (بلا سقف)
  proDeductionCents    Int      @default(0) // الحصة المهنية
  rniCents             Int      @default(0) // الدخل الصافي الخاضع
  irGrossCents         Int      @default(0) // IR قبل الأعباء العائلية
  familyDeductionCents Int      @default(0) // خصم الأعباء العائلية (سقف 6 أشخاص)
  irNetCents           Int      @default(0) // IR الصافي (لا ينزل عن صفر)
  netCents             Int      @default(0) // الصافي للدفع
  employerCostCents    Int      @default(0) // اشتراكات المشغّل (تكلفة فوق الإجمالي)
  totalCostCents       Int      @default(0) // إجمالي تكلفة المشغّل (gross + اشتراكات)
  smigBreached         Boolean  @default(false) // أقل من الحد الأدنى — يمنع الاعتماد (SPEC §11.2)
  warningsJson         String? // JSON نصي: تحذيرات (تجاوز سقوف معفاة، قواعد غير موثقة...)
  rulesJson            String? // مرجعية القواعد المستخدمة (key → value/source/effectiveFrom) — SPEC 6ب
  dailyJson            String? // تفصيل أيام العمل (شفافية «كيف حُسب كل مبلغ» — SPEC §4.3)
  snapshotJson         String? // نسخة ثابتة عند الاعتماد
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  period  PayPeriod     @relation(fields: [periodId], references: [id])
  worker  User          @relation("PayslipWorker", fields: [workerUserId], references: [id])
  lines   PayslipLine[]

  @@unique([periodId, workerUserId])
  @@unique([companyId, refNumber])
  @@index([companyId, workerUserId])
}

/// بند كشف مفصّل (SPEC §5: payslip_lines): كل مبلغ بطبيعته وسببه — شفافية «كيف حُسب كل مبلغ» (SPEC §4.3)
/// kinds: base_hours | absence_deduction | ot_day_normal | ot_night_normal | ot_day_rest | ot_night_rest
///        | allowance_transport | allowance_meals | bonus | deduction
///        | cnss_employee_short | cnss_employee_long | amo_employee | pro_deduction | ir_gross | family_deduction
///        | employer_prest_short | employer_prest_long | employer_family | employer_amo | employer_tfp
model PayslipLine {
  id              String   @id @default(cuid())
  payslipId       String
  kind            String
  minutes         Int? // للبنود الزمنية (أساس/إضافي)
  rateBp          Int? // النسبة المطبقة أساس 10000 (بنود الإضافي/الاقتطاعات)
  amountCents     Int // موجب = استحقاق، سالب = خصم/اقتطاع
  exemptIrCents   Int      @default(0) // الجزء المعفى من IR ضمن البند (الباقي خاضع)
  exemptCnssCents Int      @default(0) // الجزء المعفى من CNSS/AMO ضمن البند
  order           Int      @default(0) // ترتيب العرض في القسيمة
  label           String? // تسمية البنود اليدوية (المولَّة آليًا تُترجم من kind)
  reason          String? // سبب البند اليدوي — «كل بند له سبب ومنشئ» (SPEC §4.3)
  createdByUserId String? // منشئ البند اليدوي
  createdAt       DateTime @default(now())

  payslip Payslip @relation(fields: [payslipId], references: [id])

  @@index([payslipId, order])
}

/// دفتر الحركات المالي (SPEC §4.3 و§5: ledger_entries): append-only لا يُعدَّل ولا يُحذف
/// القيود تُكتب عند الاعتماد (وحركة كل بنود اليدوي) — التصحيح بقيد عكسي/جديد لا تعديل
model LedgerEntry {
  id              String   @id @default(cuid())
  companyId       String
  payslipId       String?
  periodId        String?
  workerUserId    String?
  kind            String // payslip_approved | payslip_adjustment | payslip_reversal
  amountCents     Int // صافي الحركة (موجب استحقاق، سالب عكس/تصحيح)
  refNumber       String?
  entryJson       String? // ملخص البنود وقت القيد (نسخة نصية)
  createdByUserId String?
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([payslipId])
}

// ─────────────────────────────────────────────────────────────
// المسارات والتصاريح الرسمية (SPEC §12 و§4.6 — المرحلة 6ج)
// ⚠️ ملكية المخطط للمساعد الثاني (COORDINATION §3) — نُفِّذت هنا لسابقة المراحل 4/5/6أ/6ب
// وغياب بيئة المساعد الثاني — **يُرجى مراجعتها واعتمادها + migration موقّعة (4+5+6 معًا)**.
// القواعد النافذة: تعريف المسار بيانات لا كود (SPEC §12) | الحزمة غير المكتملة تمنع الاعتماد
// | لا يُصدَّر ملف رسمي بلا مواصفة مفعّلة واعتماد محاسب (SPEC §4.6) | الملف المُصدَّر ثابت + hash
// | عينات الاختبار موسومة isSample ولا تُفعَّل في الإنتاج أبدًا (SPEC §4.6)
// ─────────────────────────────────────────────────────────────

/// مسار أجور (SPEC §12): تعريف كامل من البيانات — الحد الأدنى، المدة، الليل، الاشتراكات كقائمة بنود،
/// خطوات الضريبة كقائمة قابلة للتركيب، وملف التصريح المرتبط (declaration_profile)
/// companyId=null يعني قالب منصة (general/agricultural/الحزم الفارغة)؛ الشركة تنسخ وتعدّل نسختها
model PayRegime {
  id                          String    @id @default(cuid())
  companyId                   String? // null = قالب منصة
  key                         String // general | agricultural | public_civil_service | public_entreprise | custom-<slug>
  name                        String // اسم العرض (يُترجم المفتاح المعياري، والاسم الحر يُعرض كما هو)
  bundle                      String    @default("general") // general | agricultural | public_civil_service | public_entreprise | custom
  bundleStatus                String    @default("incomplete") // complete | incomplete — غير المكتملة تمنع اعتماد الكشوف
  minWageType                 String    @default("hourly") // hourly (SMIG) | daily (SMAG)
  minWageCents                Int // الحد الأدنى بالسنتيم (1792 ساعي / 9744 يومي)
  dailyHours                  Int       @default(8) // المدة القانونية اليومية
  weeklyHours                 Int       @default(44) // 44 عام / 48 فلاحي (2496÷52)
  annualHours                 Int? // 2496 فلاحي — null للعام
  nightStart                  String    @default("21:00") // حدود الليل تختلف بين المسارات (SPEC §12)
  nightEnd                    String    @default("06:00")
  monthlyDaysBasis            Int       @default(26) // أساس الأيام الشهري للفلاحي (قابل للضبط)
  declarationProfile          String    @default("cnss_ebds") // none | cnss_ebds | dgi_xml — التصريح مرتبط بالمسار
  version                     Int       @default(1) // تعديل المسار ينشئ إصدارًا جديدًا لا يعدّل القديم
  isActive                    Boolean   @default(true)
  effectiveFrom               DateTime
  source                      String? // مرسوم/قانون — «وثّق مصدر كل قيمة» (SPEC §12)
  needsAccountantConfirmation Boolean   @default(false) // الفلاحي: قاعدة الأساس تحتاج تأكيدًا واحدًا
  confirmedBy                 String? // المحاسب الذي أكّد
  confirmedAt                 DateTime?
  notes                       String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  company           Company?                 @relation(fields: [companyId], references: [id])
  contributionItems RegimeContributionItem[]
  calcSteps         RegimeCalcStep[]
  assignments       RegimeAssignment[]

  @@unique([companyId, key, version])
  @@index([companyId, isActive])
  @@index([bundle, bundleStatus])
}

/// بند اشتراك واحد في مسار (SPEC §12: «قائمة بنود» — الحساب يقرأها ولا يفترض CNSS/AMO دائمًا)
/// كل بند: الاسم، الجهة (أجير/مشغّل)، النسبة أو المبلغ، السقف، الأساس، الترتيب
model RegimeContributionItem {
  id           String  @id @default(cuid())
  regimeId     String
  key          String // cnss_employee_short | cnss_employee_long | amo_employee | employer_prest_short | employer_prest_long | employer_family | employer_amo | employer_tfp | <custom-slug>
  side         String // employee | employer
  label        String // اسم العرض في القسيمة
  rateBp       Int // النسبة أساس 10000 (520 = 0.52%) — 0 مع amountCents = مبلغ ثابت
  amountCents  Int? // مبلغ ثابت إن وُجد (بديل النسبة)
  ceilingCents Int? // سقف الأساس (600000 لفرعي CNSS القصير/الطويل) — null = بلا سقف
  basis        String  @default("cnss_base") // cnss_base (بعد المعفى) | sbi | gross
  order        Int     @default(0)
  isActive     Boolean @default(true)
  source       String? // مصدر النسبة (تعميم CNSS...)

  regime PayRegime @relation(fields: [regimeId], references: [id])

  @@index([regimeId, order])
}

/// خطوة حساب قابلة للتركيب في مسار (SPEC §12: «قائمة خطوات لا دالة واحدة ثابتة»)
/// kinds: employee_contributions | pro_deduction_tiered | ir_brackets | family_deduction | net_summary | employer_contributions
/// paramsJson: معاملات الخطوة (fromPayRules=true يقرأ من pay_rules السارية، أو قيم صريحة لمسار مخصص)
model RegimeCalcStep {
  id         String  @id @default(cuid())
  regimeId   String
  kind       String
  paramsJson String  @default("{}")
  order      Int     @default(0)
  isActive   Boolean @default(true)

  regime PayRegime @relation(fields: [regimeId], references: [id])

  @@index([regimeId, order])
}

/// إسناد عامل لمسار بتاريخ سريان (SPEC §12) — الانتقال بين مسارين يقسم الشهر (تحذير + مسار لاحق)
model RegimeAssignment {
  id            String    @id @default(cuid())
  companyId     String
  regimeId      String
  workerUserId  String
  effectiveFrom DateTime
  endedAt       DateTime? // نهاية الإسناد عند الانتقال لمسار آخر
  createdBy     String
  createdAt     DateTime  @default(now())

  company Company   @relation(fields: [companyId], references: [id])
  regime  PayRegime @relation(fields: [regimeId], references: [id])

  @@index([companyId, workerUserId])
  @@index([regimeId])
}

/// سجل المواصفات الرسمية (SPEC §4.6): جهة، نوع، إصدار، حالة مسودة←اختبار←مفعّلة←مسحوبة
/// DGI: xsdContent يرفعه المحاسب | CNSS: layoutJson تعريف تخطيط قابل للتحرير
/// isSample=true → عينة موسومة SAMPLE-NOT-OFFICIAL لا تُفعَّل في الإنتاج أبدًا
model DeclarationSpec {
  id            String    @id @default(cuid())
  companyId     String? // null = مستوى المنصة (عينات)
  authority     String // cnss | dgi
  kind          String // monthly | annual_9421 | corrective | neant
  version       Int
  effectiveFrom DateTime
  sourceRef     String? // مرجع/رابط الوثيقة الرسمية
  layoutJson    String? // CNSS (eBDS): ترتيب الحقول، العرض الثابت، الترميز، الرأس/الذيل، تنسيقات
  xsdContent    String? // DGI: مخطط XSD الرسمي (نص)
  mappingJson   String? // ربط حقول الأجور بعناصر الملف — إعداد قابل للتعديل لا كود
  status        String    @default("draft") // draft | testing | active | retired
  isSample      Boolean   @default(false)
  uploadedBy    String
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id])
  declarations Declaration[]

  @@unique([companyId, authority, kind, version])
  @@index([authority, kind, status])
}

/// تصريح واحد في دورة الاعتماد (SPEC §4.6): مسودة ← مولَّد ← مراجعة محاسب ← معتمد ← مُصدَّر ← مُودَع
/// لا يخرج ملف رسمي قبل اعتماد المحاسب؛ التصحيح تصريح جديد مرتبط بالأصلي (correctsWith)
model Declaration {
  id             String    @id @default(cuid())
  companyId      String
  specId         String
  periodId       String? // فترة الأجور (الشهري) — null للسنوي
  periodKey      String // "2026-10" شهري | "2026" سنوي — مفتاح العرض والتفرد
  authority      String // cnss | dgi (نسخة من المواصفة للتثبيت)
  kind           String // monthly | annual_9421 | corrective | neant
  status         String    @default("draft") // draft | generated | accountant_review | approved | rejected | exported | filed
  summaryJson    String? // ملخص الأرقام للتدقيق (إجمالي كل اشتراك + مقارنة الفترة السابقة)
  validationJson String? // أخطاء/تحذيرات التحقق بالمخطط (العنصر، السبب)
  reviewNote     String? // ملاحظة المحاسب (اعتماد أو رفض)
  reviewedBy     String?
  reviewedAt     DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  exportedBy     String?
  exportedAt     DateTime?
  filedAt        DateTime?
  filedRef       String? // رقم مرجع الإيداع اليدوي
  correctsWith   String? // id التصريح الأصلي (التصحيحي مرتبط لا معدِّل)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company              @relation(fields: [companyId], references: [id])
  spec     DeclarationSpec      @relation(fields: [specId], references: [id])
  files    DeclarationFile[]
  receipts DeclarationReceipt[]

  @@index([companyId, authority, kind, periodKey])
  @@index([companyId, status])
}

/// الملف الرسمي المُصدَّر (وثيقة قانونية — SPEC §4.6): نسخة ثابتة + hash + إصدار المواصفة
model DeclarationFile {
  id            String   @id @default(cuid())
  declarationId String
  content       String // محتوى الملف (eBDS نص / XML) — نسخة ثابتة لا تتغير
  sha256        String // تجزئة SHA-256 للوثيقة
  specVersion   Int
  format        String // ebds | xml
  sizeBytes     Int
  exportedBy    String
  createdAt     DateTime @default(now())

  declaration Declaration @relation(fields: [declarationId], references: [id])

  @@index([declarationId])
}

/// إشعار الاستلام بعد الإيداع اليدوي (SPEC §4.6): تاريخ + مرجع + PDF مرفوع
model DeclarationReceipt {
  id            String   @id @default(cuid())
  declarationId String
  filedAt       DateTime
  filedRef      String?
  receiptB64    String? // PDF إشعار الاستلام (base64)
  uploadedBy    String
  createdAt     DateTime @default(now())

  declaration Declaration @relation(fields: [declarationId], references: [id])

  @@index([declarationId])
}

// ─────────────────────────────────────────────────────────────
// التقارير والتصدير (SPEC §4.4.1 — المرحلة 7)
// ⚠️ ملكية المخطط للمساعد الثاني (COORDINATION §3) — نُفِّذت هنا لسابقة المراحل 4/5/6
// وغياب بيئة المساعد الثاني — **يُرجى مراجعتها واعتمادها + migration موقّعة**.
// القواعد النافذة: التوليد في الخادم دائمًا | كل تصدير يُسجَّل (من، ماذا، متى)
// | المستند المعتمد نسخة ثابتة لا تتغير (fileBytes + fileHash) — التصحيح يولّد إصدارًا
// مرقّمًا جديدًا لا يعدّل القديم | علامة تحقق: رقم مرجعي + QR يتحقق منه الخادم.
// ─────────────────────────────────────────────────────────────

/// مستند مُولَّد (SPEC §5: generated_documents): نوع، لغة، صيغة، منشئ، تجزئة hash
/// kinds: payslip | payroll_summary | attendance_statement | hours_statement
///        | declarations_summary | compliance_report | platform_summary
/// targetId: payslipId | periodId | declarationId | workerUserId (بيان حضور) | "platform"
model GeneratedDocument {
  id              String   @id @default(cuid())
  companyId       String
  kind            String
  format          String // pdf | docx | png
  language        String // ar | fr | en | es
  targetId        String
  targetLabel     String // PS-202610-0001 | 2026-10 | رقم التصريح... (للتدقيق والعرض)
  subjectUserId   String? // صاحب المستند إن كان شخصيًا (قسيمة/بيان حضور) — يرى العامل مستنداته
  version         Int      @default(1) // إصدار يتصاعد عند تغيّر المحتوى — القديم لا يُمسّ
  refNumber       String // RD-YYMMDD-XXXX فريد داخل الشركة — يُطبع QR عليه
  contentHash     String // SHA-256 للبيانات المجمدة (مستقل عن الصيغة) — يُطبع بالمستند وفي QR
  fileHash        String // SHA-256 للمحتوى المُخزَّن — تحقق QR (غير معدَّل)
  fileSize        Int
  fileBytes       Bytes // النسخة الثابتة نفسها (SPEC §4.4.1: تُحفظ نسخة ثابتة)
  optionsJson     String? // خيارات التوليد (includeEmployerShare مثلًا)
  note            String? // ملاحظة إدارية تُطبع في المستند — تعديلها يولّد نسخة جديدة مرقّمة (لا تعديل للقديم)
  createdByUserId String
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, kind, targetId, format, language, version])
  @@unique([companyId, refNumber])
  @@index([companyId, createdAt])
  @@index([targetId])
  @@index([subjectUserId])
}

// ─────────────────────────────────────────────────────────────
// نقل ملكية المنصة (SPEC §3.2 — المرحلة 8) — ملكية التغيير: المساعد الأول
// ⚠️ بانتظار migration موقّعة (مع المعلقة للمرحلة 7) — راجع docs/WORKLOG.md
// ─────────────────────────────────────────────────────────────

/// عملية نقل ملكية واحدة (SPEC §3.2): موافقتان منفصلتان (حالي/جديد) + تجميد إداري مؤقت
/// + نسخة احتياطية وتصدير بصيغة مفتوحة وفحص تطابق + تنفيذ (تبديل كيان المالك + إبطال
/// كل الجلسات + إلغاء عضويات super_admin السابقة) — كل خطوة تُسجَّل في سجل التدقيق.
/// states: awaiting_current_owner | awaiting_new_owner | approved | completed | cancelled
model OwnershipTransfer {
  id                        String    @id @default(cuid())
  state                     String    @default("awaiting_current_owner")
  reason                    String? // سبب النقل (موثَّق في التدقيق)
  // المالك الجديد (بيانات كيان platform_owner البديل — SPEC §3.2)
  newOwnerLegalName         String
  newOwnerDisplayName       String
  newOwnerContactEmail      String?
  newOwnerContactPhone      String?
  newOwnerInitialAdminEmail String // حساب super_admin الابتدائي للمالك الجديد (يُنشأ عند التنفيذ)
  // هوية المالك السابق كاملة قبل النقل (JSON نصي — للتدقيق، لا يُفقد شيء)
  oldOwnerJson              String?
  // الموافقتان المنفصلتان (SPEC §3.2 خطوة 1) — كل موافقة تُعيد المصادقة بكلمة المرور
  initiatedByUserId         String
  currentOwnerApprovedAt    DateTime?
  currentOwnerApprovedBy    String?
  newOwnerApprovedAt        DateTime?
  newOwnerApprovedByUserId  String? // المشغّل الذي أدخل رمز موافقة المالك الجديد
  approvalCodeHash          String? // SHA-256 لرمز موافقة المالك الجديد (يُسلَّم خارج النظام)
  // النسخ الاحتياطي والتصدير المفتوح وفحص التطابق (SPEC §3.2 خطوة 2)
  backupPath                String?
  backupSha256              String?
  backupTableCount          Int?
  exportPath                String?
  exportSha256              String?
  integrityCheckStatus      String? // ok | failed
  integrityCheckDetail      String?
  // التنفيذ (SPEC §3.2 خطوة 3)
  executedAt                DateTime?
  executedByUserId          String?
  newAdminUserId            String? // المستخدم الابتدائي للمالك الجديد
  revokedSuperAdminCount    Int? // عضويات super_admin السابقة المُلغاة
  sessionsInvalidatedUsers  Int? // عدد المستخدمين الذين أُبطلت جلساتهم (الكل — تدوير أمان)
  secretsRotatedAt          DateTime? // تأكيد المشغّل: أسرار .env والبنية دُوِّرت (دليل الأداة)
  secretsRotatedByUserId    String?
  // الإلغاء (قبل التنفيذ فقط)
  cancelledAt               DateTime?
  cancelledByUserId         String?
  cancelReason              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([state])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// الاستقطاب والتوظيف (طلب المالك 2026-10-24): باحثو عمل عامّون + وظائف شاغرة
// في مشاريع الشركات المسجلة — بتحقق آلي (OTP إيمايل+هاتف) ووثيقة هوية
// تُصادق من الأدمن أو السوبر أدمن. العزل: الوظائف ببيانات الشركة حصرًا،
// والباحثون كيان عام مستقل عن مستخدمي الشركات (جدول خاص لا UserMembership).
// ─────────────────────────────────────────────────────────────

/// باحث عن عمل — حساب عام مستقل (لا يظهر في مستخدمي الشركات حتى توظيفه فعليًا)
model JobSeeker {
  id                         String    @id @default(cuid())
  email                      String    @unique // مطبَّع: أحرف صغيرة بلا فراغات
  phone                      String    @unique // مطبَّع بصيغة دولية +212XXXXXXXXX
  fullName                   String
  passwordHash               String
  locale                     String    @default("ar")
  /// التحقق الآلي: البريد إلزامي + (الهاتف أو تيليغرام) كعامل ثانٍ — مع الوثيقة
  emailVerifiedAt            DateTime?
  phoneVerifiedAt            DateTime?
  /// ربط تيليغرام: قناة OTP بديلة للهاتف (طلب المالك 2026-10-24) — chat id فريد
  telegramChatId             String?   @unique
  telegramUsername           String?
  telegramLinkTokenHash      String?   @unique
  telegramLinkTokenExpiresAt DateTime?
  telegramLinkedAt           DateTime?
  telegramVerifiedAt         DateTime?
  /// وثيقة الهوية (بطاقة وطنية / جواز سفر / رخصة سياقة) — صورة ≤ 5MB داخل القاعدة
  documentType               String? // national_id | passport | driver_license
  documentName               String? // اسم الملف الأصلي (للعرض فقط)
  documentMime               String? // image/jpeg | image/png | image/webp
  documentBytes              Bytes? // محتوى الصورة — يُخدم لمصادقي الهوية حصرًا
  documentHash               String? // SHA-256 (سلامة + كشف التكرار)
  /// مصادقة الأدمن/السوبر أدمن (الأمر الصريح للمالك): pending → approved|rejected
  status                     String    @default("pending") // pending | approved | rejected
  rejectionReason            String?
  reviewedById               String? // userId للمصادِق (User.id — مرجع منطقي بلا FK: الباحث كيان عام)
  reviewedAt                 DateTime?
  isActive                   Boolean   @default(true) // تعطيل حساب (إساءة مثلًا) — يمنع الدخول والتقديم
  lastLoginAt                DateTime?
  sessionsInvalidatedAt      DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  applications VacancyApplication[]

  @@index([status])
  @@index([isActive])
}

/// رمز تحقق أحادي الاستخدام (OTP) للتسجيل العام — بريد أو هاتف أو تيليغرام
model OtpCode {
  id         String    @id @default(cuid())
  channel    String // email | phone | telegram
  target     String // البريد المطبَّع أو الهاتف الدولي أو Telegram chat id
  codeHash   String // SHA-256(رمز 6 أرقام + ملح) — الرمز ذاته لا يُخزَّن أبدًا
  purpose    String    @default("seeker_register") // نطاق الرمز (توسعة مستقبلية)
  attempts   Int       @default(0) // عدّاد المحاولات (حد 5 ثم إبطال الرمز)
  expiresAt  DateTime // 10 دقائق من الإصدار
  consumedAt DateTime? // وقت الاستهلاك (أحادي الاستخدام)
  createdAt  DateTime  @default(now())

  @@index([channel, target])
  @@index([expiresAt])
}

/// وظيفة شاغرة ضمن مشروع شركة — تُعرض علنًا عند status=published فقط
model ProjectVacancy {
  id             String    @id @default(cuid())
  companyId      String
  projectId      String
  title          String
  description    String
  requirements   String? // المؤهلات/الخبرات المطلوبة (نص حر)
  employmentType String    @default("full_time") // full_time | part_time | temporary | seasonal | internship
  salaryMin      Int? // سنتيم MAD (Int حصرًا — قاعدة المنصة)
  salaryMax      Int?
  openings       Int       @default(1) // عدد المناصب
  contactEmail   String? // قناة تواصل اختيارية تظهر للعموم
  contactPhone   String? // بصيغة دولية (تُتحقق كالهااتف)
  status         String    @default("draft") // draft | published | closed
  publishedAt    DateTime?
  closesAt       DateTime? // إغلاق تلقائي عند بلوغه (فحص عند القراءة)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company              @relation(fields: [companyId], references: [id])
  project      Project              @relation(fields: [projectId], references: [id])
  applications VacancyApplication[]

  @@index([companyId, status])
  @@index([projectId])
  @@index([status, publishedAt])
}

/// طلب تقديم باحث (مُعتمَد) على وظيفة منشورة — طلب واحد لكل (باحث، وظيفة)
model VacancyApplication {
  id        String   @id @default(cuid())
  vacancyId String
  seekerId  String
  coverNote String? // كلمة تقديم اختيارية (≤ 2000 حرف)
  status    String   @default("submitted") // submitted | viewed | shortlisted | rejected | hired | withdrawn
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vacancy ProjectVacancy @relation(fields: [vacancyId], references: [id])
  seeker  JobSeeker      @relation(fields: [seekerId], references: [id])

  @@unique([vacancyId, seekerId])
  @@index([vacancyId, status])
  @@index([seekerId])
}
