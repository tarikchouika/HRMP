# HRMP — نموذج متغيرات البيئة
# انسخه ثم اضبط قيمك:  cp .env.example .env
# ⚠️ ملف .env لا يُرفع إلى git أبدًا (متجاهَل في .gitignore) — راجع docs/COORDINATION.md §7

# ── قاعدة البيانات (SQLite عبر Prisma) ──
# التطوير السحابي: مسار ملف محلي، مثال:
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# الخادم المحلي (Termux): مسار مطلق في وحدة تخزين الهاتف — راجع docs/DATABASE_GUIDE.md §4
# DATABASE_URL="file:/storage/emulated/0/hrmp/db/hrmp.db"

# ── سر توقيع جلسات JWT (إلزامي) ──
# 16 حرفًا حدًا أدنى (يرفض التطبيق الأقصر) — الموصى به 64 سداسيًا
# ولّد قيمة عشوائية:  openssl rand -hex 32
AUTH_SECRET="change-me-generate-a-random-value-with-openssl-rand-hex-32"

# ── اختياري عند النشر (Vercel) — راجع docs/DEPLOYMENT.md ──
# NEXTAUTH_URL="https://your-domain.example"

# ── النفق الدائم (Cloudflare Tunnel من الهاتف) — إلزامي على الخادم المحلي فقط ──
# راجع docs/DATABASE_GUIDE.md §2.4 وinfra/termux/run-tunnel.sh — التوكن لا يُرفع إلى git أبدًا
# CLOUDFLARE_TUNNEL_TOKEN=""

# ── اختياري: دفع Web Push للإشعارات (المرحلة 5 — SPEC §7 محوّل قابل للتبديل) ──
# بلا ضبط هذه المفاتيح يعمل الإشعار داخل التطبيق فقط (no-op موثَّق في السجل)
# التوليد: bunx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:owner@fwms.local"

# ── إرسال رموز التحقق (OTP) لتسجيل الباحثين عن عمل (طلب المالك 2026-10-24) ──
# «التأكد الألي من رقم هاتفه و الإيمايل»: بلا مزوّد مضبوط يرفض الإرسال صراحة
# (503 برسالة إدارية) — لا حلقة أمنية تُختصر. راجع docs/DEPLOYMENT.md §الاستقطاب.

# البريد — SMTP عبر nodemailer (مزوّدك البريدي أو SMTP ل Gmail/ OVH/ الاستضافة):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"            # 465 للـSSL أو 587 للـSTARTTLS
# SMTP_SECURE="false"        # true عند 465
# SMTP_USER="no-reply@example.com"
# SMTP_PASS="كلمة_المرور_أو_كلمة_تطبيق"
# SMTP_FROM="HRMP <no-reply@example.com>"

# الهاتف — بوابة HTTP عامة تقبل أي مزوّد SMS (أو Webhook n8n/Make):
# يُرسل POST JSON {phone, message} مع ترويسة Bearer إن ضُبط التوكن.
# SMS_WEBHOOK_URL="https://sms-provider.example.com/send"
# SMS_WEBHOOK_TOKEN=""

# تيليغرام — قناة OTP بديلة عن SMS + إشعارات المشرف:
# أنشئ بوتًا عبر @BotFather وضع التوكن هنا. اسم المستخدم للرابط العام.
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_BOT_USERNAME="hrmpotp_bot"
# TELEGRAM_ADMIN_CHAT_ID="<chat-id-owner>"
# TELEGRAM_WEBHOOK_SECRET="سلسلة-عشوائية-طويلة"
# قاعدة API للاختبار المعزول فقط (اتركها فارغة في الإنتاج):
# TELEGRAM_API_BASE="http://127.0.0.1:3200"

# وضع التجربة الصريح (لا يُستعمل في إنتاج حقيقي أبدًا): يُعاد رمز OTP في الاستجابة
# والواجهة تعرضه بتحذير — لاختبار التسجيل محليًا بلا أي مزوّد.
# OTP_DEV_SHOW_CODE="1"
